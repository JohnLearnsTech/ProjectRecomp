<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/w_bg" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/lbl_l" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="@font/space_grotesk_medium" android:textSize="10sp" android:letterSpacing="0.14" android:textAllCaps="true" android:textColor="#8C8C8C" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/lbl_r" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/space_grotesk_medium" android:textSize="10sp" android:letterSpacing="0.14" android:textAllCaps="true" android:textColor="#8C8C8C" android:maxLines="1" />
  </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <Chronometer android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/doto_black" android:textSize="38sp" android:textColor="#FFFFFF" android:includeFontPadding="false" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/space_grotesk_medium" android:textSize="11sp" android:textColor="#8C8C8C" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" android:layout_marginBottom="5dp" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp" android:gravity="center_horizontal">
      <TextView android:id="@+id/toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_pill_line" android:fontFamily="@font/space_grotesk_bold" android:textSize="11sp" android:letterSpacing="0.06" android:textAllCaps="true" android:textColor="#FFFFFF" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Pause" android:maxLines="1" />
      <TextView android:layout_width="1dp" android:layout_height="6dp" />
      <TextView android:id="@+id/stop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_pill_fill" android:fontFamily="@font/space_grotesk_bold" android:textSize="11sp" android:letterSpacing="0.06" android:textAllCaps="true" android:textColor="#000000" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Stop" android:maxLines="1" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
