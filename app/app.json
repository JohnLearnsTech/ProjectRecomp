{
  "expo": {
    "name": "Project Recomp",
    "slug": "recomp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.johnlearnstech.recomp",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      "react-native-health-connect",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Timer",
              "label": "Recomp · Habit timer",
              "description": "Your running habit timer with pause and stop, or one tap to start a timed habit.",
              "minWidth": "180dp",
              "minHeight": "70dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Habits",
              "label": "Recomp · Habits",
              "description": "Today’s habits at a glance; tap a timed one to start it.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Food",
              "label": "Recomp · Food",
              "description": "Calories and protein left, with a quick add.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Lift",
              "label": "Recomp · Lift day",
              "description": "Today’s lift and the 10-minute version.",
              "minWidth": "180dp",
              "minHeight": "70dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Level",
              "label": "Recomp · Level",
              "description": "Your rank, streak and how close the next one is.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Steps",
              "label": "Recomp · Steps",
              "description": "Steps today against your target.",
              "minWidth": "110dp",
              "minHeight": "70dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ],
          "fonts": [
            "./assets/fonts/Doto-Black.ttf",
            "./assets/fonts/SpaceGrotesk-Medium.ttf",
            "./assets/fonts/SpaceGrotesk-Bold.ttf"
          ]
        }
      ]
    ],
    "scheme": "recomp",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "191b9cdd-4a1b-4ddc-a571-e835119174c1"
      }
    },
    "owner": "johnlearnstech"
  }
}
